<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controller.MainController">
   <top>
      <VBox alignment="CENTER" spacing="20.0" styleClass="header-section">
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <Label styleClass="app-title" text="Mood-Based Recommender">
               <font>
                  <Font name="System Bold" size="32.0" />
               </font>
            </Label>
            <Label styleClass="app-subtitle" text="Discover quotes and music that match your mood">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" spacing="15.0">
               <children>
                  <JFXToggleButton fx:id="onlineModeToggle" text="Online Mode" />
                  <JFXButton fx:id="settingsButton" onAction="#showSettings" styleClass="icon-button" text="⚙️" />
                  <JFXButton fx:id="favoritesButton" onAction="#showFavorites" styleClass="icon-button" text="❤️" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <StackPane fx:id="contentPane">
         <children>
            <!-- Mood Selection View -->
            <ScrollPane fx:id="moodSelectionView" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="mood-selection-pane">
               <content>
                  <VBox alignment="CENTER" spacing="30.0">
                     <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                     </padding>
                     <children>
                        <Label styleClass="section-title" text="How are you feeling today?">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                        <GridPane fx:id="moodGrid" alignment="CENTER" hgap="20.0" vgap="20.0">
                           <columnConstraints>
                              <ColumnConstraints />
                              <ColumnConstraints />
                              <ColumnConstraints />
                           </columnConstraints>
                        </GridPane>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            
            <!-- Results View -->
            <ScrollPane fx:id="resultsView" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="results-pane" visible="false">
               <content>
                  <VBox spacing="20.0">
                     <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <JFXButton fx:id="backButton" onAction="#showMoodSelection" styleClass="back-button" text="← Back" />
                              <Label fx:id="selectedMoodLabel" styleClass="selected-mood-label">
                                 <font>
                                    <Font name="System Bold" size="20.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        
                        <HBox spacing="30.0">
                           <children>
                              <!-- Quotes Section -->
                              <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="section-title" text="Inspirational Quotes">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                    <VBox fx:id="quotesContainer" spacing="10.0" />
                                 </children>
                              </VBox>
                              
                              <!-- Songs Section -->
                              <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="section-title" text="Recommended Music">
                                       <font>
                                          <Font name="System Bold" size="18.0" />
                                       </font>
                                    </Label>
                                    <VBox fx:id="songsContainer" spacing="10.0" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        
                        <!-- Music Player Controls -->
                        <VBox fx:id="playerControls" spacing="10.0" styleClass="player-controls" visible="false">
                           <children>
                              <Label fx:id="nowPlayingLabel" styleClass="now-playing-label" text="Now Playing: ">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <HBox alignment="CENTER" spacing="15.0">
                                 <children>
                                    <JFXButton fx:id="playPauseButton" onAction="#togglePlayPause" styleClass="player-button" text="⏸️" />
                                    <JFXButton fx:id="stopButton" onAction="#stopMusic" styleClass="player-button" text="⏹️" />
                                    <JFXSlider fx:id="volumeSlider" max="1.0" value="0.5" HBox.hgrow="ALWAYS" />
                                    <Label text="🔊" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </StackPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="10.0" styleClass="status-bar">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <Label fx:id="statusLabel" text="Ready" />
            <Region HBox.hgrow="ALWAYS" />
            <JFXProgressBar fx:id="loadingProgress" visible="false" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
